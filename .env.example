# Descomenta esta línea SOLO en la máquina donde exista de verdad el
# dispositivo de SERIAL_DEVICE. Añade docker-compose.serial.yml a la mezcla,
# que es quien mapea el /dev dentro del contenedor. Sin esto, `docker compose
# up` funciona igual pero sin acceso al puerto serie directo (modo
# "tcp"/ser2net sigue disponible siempre).
# COMPOSE_FILE=docker-compose.yml:docker-compose.serial.yml

SER2NET_HOST=127.0.0.1
SER2NET_PORT=3002
# Puerto serie físico al que también está enganchado ser2net (mismo
# dispositivo). Solo se usa si conectas en modo "serial" desde la app.
SERIAL_DEVICE=/dev/ttyUSB0
SERIAL_BAUDRATE=9600
POLL_INTERVAL=1.0
HISTORY_MAX_POINTS=2000

# Requerida por todos los endpoints /api/*. Genera una propia con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# No reutilices este valor de ejemplo.
API_KEY=cambia-esto-por-una-key-generada
